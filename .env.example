# Copy this file to ".env" in the project root and fill in the values.
# ".env" is ignored by git, so your passwords are never pushed.
# On Render you do NOT use a .env file: you add the same names as "Environment Variables" instead.

PORT=5000

# --- MySQL ---
# XAMPP default: user root, EMPTY password
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=erp_db
# Cloud databases (TiDB Cloud etc.) need an encrypted connection: set DB_SSL=true
DB_SSL=false

# --- Firebase: SERVER side ---
# On your PC: the service-account key file (Project settings > Service accounts).
# NEVER commit this file. The path is relative to the /server folder.
FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json
# On Render: paste the WHOLE contents of that file here instead (leave the line above out).
# FIREBASE_SERVICE_ACCOUNT_JSON=

# The first person who signs up with THIS email becomes the admin.
ADMIN_EMAIL=you@example.com

# --- Firebase: BROWSER side (Project settings > General > Your apps > Web app > Config) ---
# These are public identifiers (not secret), but keep them in .env so each person uses their own.
# firebaseConfig name      ->  variable
#   apiKey                 ->  VITE_FIREBASE_API_KEY
#   authDomain             ->  VITE_FIREBASE_AUTH_DOMAIN
#   projectId              ->  VITE_FIREBASE_PROJECT_ID
#   storageBucket          ->  VITE_FIREBASE_STORAGE_BUCKET
#   messagingSenderId      ->  VITE_FIREBASE_MESSAGING_SENDER_ID   (a number like 123456789012)
#   appId                  ->  VITE_FIREBASE_APP_ID                (looks like 1:123456789012:web:abc123)
#   measurementId          ->  not needed
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
